{
    "configurations": [
        {
            "name": "Simulator",
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "c11",
            "includePath": [
                "${workspaceFolder}/CoreLogic/inc",
                "${workspaceFolder}/MockSystem"
            ],
            "defines": [
                "SIM_MODE",
                "_GNU_SOURCE"
            ],
            "intelliSenseMode": "linux-gcc-x64"
        },
        {
            "name": "STM32",
            "compilerPath": "/usr/bin/arm-none-eabi-gcc",
            "cStandard": "c11",
            "includePath": [
                "${workspaceFolder}/CoreLogic/inc",
                "${workspaceFolder}/Drivers/CMSIS/Include",
                "${workspaceFolder}/Drivers/STM32F4xx_HAL_Driver/Inc"
            ],
            "defines": [
                "STM32F401xE",
                "USE_HAL_DRIVER"
            ],
            "intelliSenseMode": "gcc-arm"
        }
    ],
    "version": 4,
    "default": "Simulator"
}