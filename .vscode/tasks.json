{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "BuildSim",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-I", "CoreLogic/inc",
                "-I", "MockSystem",
                "-D", "SIM_MODE",
                "-std=c11",
                "-g",
                "-o", "sim_engine",
                "CoreLogic/src/*.c",
                "MockSystem/*.c",
                "-lpthread"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": {
                "owner": "c",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        }
    ]
}